@model Assignment

@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="text-decoration-none">&larr; @Model.Course.Name assignments</a>
        <h1 class="mt-2">@Model.Title</h1>
        <p class="text-muted mb-0">@Model.Course.Code — @Model.Course.Name</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.IsActive)
        {
            <a asp-action="Edit" asp-route-id="@Model.AssignmentId" class="btn btn-outline-secondary">Edit</a>
        }
        <a asp-controller="Grades" asp-action="Index" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-primary">Review submissions</a>
        <a asp-action="Delete" asp-route-id="@Model.AssignmentId" class="btn btn-outline-danger">Archive</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<section class="mb-4" aria-labelledby="assignment-details-heading">
    <h2 id="assignment-details-heading" class="h4">Assignment details</h2>
    <dl class="row">
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd>
        <dt class="col-sm-3">Due date</dt>
        <dd class="col-sm-9"><time datetime="@Model.DueDate.ToString("O")">@Model.DueDate.ToLocalTime().ToString("f")</time></dd>
        <dt class="col-sm-3">Maximum points</dt>
        <dd class="col-sm-9">@Model.MaxPoints</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Archived")</dd>
    </dl>
</section>

<section aria-labelledby="submissions-heading">
    <h2 id="submissions-heading" class="h4">Submissions <span class="text-muted">(@Model.Submissions.Count)</span></h2>
    @if (Model.Submissions.Count == 0)
    {
        <p class="text-muted">No submissions have been received.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Status</th>
                        <th scope="col">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var submission in Model.Submissions.OrderBy(item => item.Student.LastName).ThenBy(item => item.Student.FirstName))
                    {
                        <tr>
                            <td>@submission.Student.FirstName @submission.Student.LastName</td>
                            <td><time datetime="@submission.SubmittedAt.ToString("O")">@submission.SubmittedAt.ToLocalTime().ToString("g")</time></td>
                            <td>@(submission.IsLate ? "Late" : "On time")</td>
                            <td>
                                @if (submission.Grade is null)
                                {
                                    <span class="text-muted">Not graded</span>
                                }
                                else
                                {
                                    <span>@submission.Grade.Score / @Model.MaxPoints</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
