@model TeacherDashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";

    var toGrade = Model.UngradedSubmissionCount;
}

@* Стили общие с дашбордом студента — обе страницы выглядят одинаково *@
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<header class="dashboard-page-heading">
    <h1>@ViewData["Title"]</h1>
</header>

<div class="dashboard-container">
    <section class="summary-cards" aria-label="Your teaching summary">
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@Model.ActiveCourseCount</p>
            <div class="dashboard-stat-heading">
                <h2>Active courses</h2>
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-book"></use></svg>
            </div>
        </article>
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@Model.ActiveStudentCount</p>
            <div class="dashboard-stat-heading">
                <h2>Active students</h2>
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-users"></use></svg>
            </div>
        </article>
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@Model.ActiveAssignmentCount</p>
            <div class="dashboard-stat-heading">
                <h2>Active assignments</h2>
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-clipboard"></use></svg>
            </div>
        </article>
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@toGrade</p>
            <div class="dashboard-stat-heading">
                <h2>Submissions to grade</h2>
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-message-clock"></use></svg>
            </div>
        </article>
    </section>

    <div class="dashboard-content">
        <section class="dashboard-panel">
            <header class="dashboard-panel-heading">
                <div>
                    <p class="dashboard-section-label">Needs attention</p>
                    <h2>Grading</h2>
                </div>
            </header>

            <div class="dashboard-empty-state">
                @if (toGrade > 0)
                {
                    <p>
                        @(toGrade == 1
                            ? "1 submission is waiting for a grade."
                            : $"{toGrade} submissions are waiting for a grade.")
                        Open a course and choose an assignment to grade its submissions.
                    </p>
                    <a class="dashboard-panel-link" asp-area="Teacher" asp-controller="Courses"
                       asp-action="Index">Go to my courses <span aria-hidden="true">→</span></a>
                }
                else
                {
                    <p>You are all caught up—there is nothing to grade.</p>
                }
            </div>
        </section>

        <section class="dashboard-panel">
            <header class="dashboard-panel-heading">
                <div>
                    <p class="dashboard-section-label">Your teaching</p>
                    <h2>Courses</h2>
                </div>
                @if (Model.ActiveCourseCount > 0)
                {
                    <a class="dashboard-panel-link" asp-area="Teacher" asp-controller="Courses"
                       asp-action="Index">All courses <span aria-hidden="true">→</span></a>
                }
            </header>

            <div class="dashboard-empty-state">
                @if (Model.ActiveCourseCount > 0)
                {
                    <p>Manage your courses, their students, and assignments, or start a new course.</p>
                }
                else
                {
                    <p>You don't have any active courses yet.</p>
                }
                <a class="btn btn-primary" asp-area="Teacher" asp-controller="Courses"
                   asp-action="Create">Create course</a>
            </div>
        </section>
    </div>
</div>
