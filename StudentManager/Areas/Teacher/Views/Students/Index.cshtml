@model CourseStudentsViewModel

@{
    ViewData["Title"] = $"Students — {Model.CourseCode}";
}

<div class="mb-4">
    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="text-decoration-none">&larr; @Model.CourseName</a>
    <h1 class="mt-2">Students</h1>
    <p class="text-muted mb-0">@Model.CourseCode — @Model.CourseName</p>
</div>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-info" role="status">No students are enrolled in this course.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Student</th>
                    <th scope="col">Student number</th>
                    <th scope="col">Email</th>
                    <th scope="col">Enrolled</th>
                    <th scope="col">Submitted</th>
                    <th scope="col">Graded</th>
                    <th scope="col">Average</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.StudentName</td>
                        <td>@(string.IsNullOrWhiteSpace(student.StudentNumber) ? "—" : student.StudentNumber)</td>
                        <td><a href="mailto:@student.Email">@student.Email</a></td>
                        <td><time datetime="@student.EnrolledAt.ToString("O")">@student.EnrolledAt.ToLocalTime().ToString("d")</time></td>
                        <td>@student.SubmittedAssignmentCount</td>
                        <td>@student.GradedAssignmentCount</td>
                        <td>@(student.AveragePercentage.HasValue ? $"{student.AveragePercentage.Value:F1}%" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
