@model Course

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">&larr; My courses</a>
        <h1 class="mt-2">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Code</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Edit course</a>
        <a asp-action="Delete" asp-route-id="@Model.CourseId" class="btn btn-outline-danger">Archive course</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<section class="mb-4" aria-labelledby="course-details-heading">
    <h2 id="course-details-heading" class="h4">Course details</h2>
    <dl class="row">
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9"><time datetime="@Model.CreatedAt.ToString("O")">@Model.CreatedAt.ToLocalTime().ToString("g")</time></dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Archived")</dd>
    </dl>
</section>

<section class="mb-5" aria-labelledby="students-heading">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 id="students-heading" class="h4 mb-0">Students <span class="text-muted">(@Model.Enrollments.Count)</span></h2>
        <a asp-controller="Students" asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-outline-primary">View students</a>
    </div>
    @if (Model.Enrollments.Count == 0)
    {
        <p class="text-muted">No students are enrolled in this course.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var enrollment in Model.Enrollments.OrderBy(item => item.Student.LastName).ThenBy(item => item.Student.FirstName).Take(5))
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@enrollment.Student.FirstName @enrollment.Student.LastName</span>
                    <span class="text-muted">@enrollment.Student.Email</span>
                </li>
            }
        </ul>
        @if (Model.Enrollments.Count > 5)
        {
            <p class="text-muted mt-2">Showing the first 5 students.</p>
        }
    }
</section>

<section aria-labelledby="assignments-heading">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 id="assignments-heading" class="h4 mb-0">Assignments <span class="text-muted">(@Model.Assignments.Count(item => item.IsActive))</span></h2>
        @if (Model.IsActive)
        {
            <a asp-controller="Assignments" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-primary">Create assignment</a>
        }
    </div>
    @if (!Model.Assignments.Any(item => item.IsActive))
    {
        <p class="text-muted">There are no active assignments for this course.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Assignment</th>
                        <th scope="col">Due</th>
                        <th scope="col">Submissions</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.Assignments.Where(item => item.IsActive).OrderBy(item => item.DueDate))
                    {
                        <tr>
                            <td><a asp-controller="Assignments" asp-action="Details" asp-route-id="@assignment.AssignmentId">@assignment.Title</a></td>
                            <td><time datetime="@assignment.DueDate.ToString("O")">@assignment.DueDate.ToLocalTime().ToString("g")</time></td>
                            <td>@assignment.Submissions.Count</td>
                            <td><a asp-controller="Grades" asp-action="Index" asp-route-assignmentId="@assignment.AssignmentId" class="btn btn-sm btn-outline-primary">Review submissions</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
