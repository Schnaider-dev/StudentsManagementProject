@model IReadOnlyList<Course>

@{
    ViewData["Title"] = "My Courses";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>My Courses</h1>
        <p class="text-muted mb-0">Manage your courses, students, and assignments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create course</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        You don't have any courses yet.
        <a asp-action="Create" class="alert-link">Create your first course</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Course</th>
                    <th scope="col">Students</th>
                    <th scope="col">Assignments</th>
                    <th scope="col">Created</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>@course.Code</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@course.CourseId">@course.Name</a>
                        </td>
                        <td>@course.Enrollments.Count</td>
                        <td>@course.Assignments.Count</td>
                        <td><time datetime="@course.CreatedAt.ToString("O")">@course.CreatedAt.ToLocalTime().ToString("d")</time></td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-controller="Students" asp-action="Index" asp-route-courseId="@course.CourseId" class="btn btn-sm btn-outline-secondary">Students</a>
                            <a asp-controller="Assignments" asp-action="Index" asp-route-courseId="@course.CourseId" class="btn btn-sm btn-outline-primary">Assignments</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
