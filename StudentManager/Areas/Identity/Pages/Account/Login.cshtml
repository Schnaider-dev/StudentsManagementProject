@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-card">
    <h1>Log in</h1>
    <p class="auth-lead">
        New here?
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
    </p>

    <form id="loginForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                   placeholder="name@example.com" />
            <label asp-for="Input.Email"></label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                   aria-required="true" placeholder="Password" />
            <label asp-for="Input.Password"></label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label"></label>
        </div>

        <button id="loginSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
            Log in
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
