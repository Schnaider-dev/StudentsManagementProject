@page
@model RegisterModel

@{
    ViewData["Title"] = "Create account";
}

<div class="auth-card">
    <h1>Create account</h1>
    <p class="auth-lead">
        Already have an account?
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
    </p>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <div class="form-floating">
                    <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name"
                           aria-required="true" placeholder="First name" />
                    <label asp-for="Input.FirstName"></label>
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-floating">
                    <input asp-for="Input.LastName" class="form-control" autocomplete="family-name"
                           aria-required="true" placeholder="Last name" />
                    <label asp-for="Input.LastName"></label>
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-floating mb-3">
            <select asp-for="Input.Role" class="form-select" aria-required="true">
                <option value="Student">Student</option>
                <option value="Teacher">Teacher</option>
            </select>
            <label asp-for="Input.Role"></label>
            <span asp-validation-for="Input.Role" class="text-danger"></span>
        </div>

        @* Номер студента нужен только студентам — для учителя поле прячется скриптом ниже *@
        <div class="form-floating mb-3" id="studentNumberGroup">
            <input asp-for="Input.StudentNumber" class="form-control" placeholder="Student number" />
            <label asp-for="Input.StudentNumber"></label>
            <span asp-validation-for="Input.StudentNumber" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                   placeholder="name@example.com" />
            <label asp-for="Input.Email"></label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true"
                   placeholder="Password" aria-describedby="passwordHelp" />
            <label asp-for="Input.Password"></label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
            <div id="passwordHelp" class="form-text">At least 6 characters, with a lowercase letter and a digit.</div>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                   aria-required="true" placeholder="Confirm password" />
            <label asp-for="Input.ConfirmPassword"></label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
            Create account
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var role = document.getElementById('Input_Role');
            var group = document.getElementById('studentNumberGroup');

            function toggleStudentNumber() {
                group.hidden = role.value !== 'Student';
            }

            role.addEventListener('change', toggleStudentNumber);
            toggleStudentNumber();
        })();
    </script>
}
