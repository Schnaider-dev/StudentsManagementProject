@using StudentManager.Models
@model StudentDashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<header class="dashboard-page-heading">
    <h1>@ViewData["Title"]</h1>
</header>

<main class="dashboard-container">
    <section class="summary-cards" aria-label="Your learning summary">
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@Model.ActiveCourseCount</p>
            <h2>Active courses</h2>
        </article>
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@Model.PendingAssignmentCount</p>
            <h2>Pending assignments</h2>
        </article>
        <article class="dashboard-stat-card">
            <p class="dashboard-stat-value">@Model.GradedAssignmentCount</p>
            <h2>Graded assignments</h2>
        </article>
        <article class="dashboard-stat-card">
            @if (Model.OverallAveragePercentage is decimal average)
            {
                <p class="dashboard-stat-value">@average.ToString("0.##")%</p>
            }
            else
            {
                <p class="dashboard-stat-value dashboard-stat-empty">Not graded yet</p>
            }
            <h2>Overall score</h2>
        </article>
    </section>

    <section class="dashboard-content">
        <section class="dashboard-panel courses-section">
            <header class="dashboard-panel-heading">
                <div>
                    <p class="dashboard-section-label">Your learning</p>
                    <h2>My courses</h2>
                </div>
                @if (Model.ActiveCourseCount > 0)
                {
                    <a class="dashboard-panel-link" asp-area="Student" asp-controller="Courses"
                       asp-action="MyCourses">All courses <span aria-hidden="true">→</span></a>
                }
            </header>

            @if (Model.ActiveCourses is { Count: > 0 })
            {
                <ul class="course-preview-list">
                    @foreach (Course course in Model.ActiveCourses)
                    {
                        <li>
                            <a class="course-preview-card" asp-area="Student" asp-controller="Courses"
                               asp-action="Progress" asp-route-courseId="@course.CourseId">
                                <span class="course-preview-code">@course.Code</span>
                                <span class="course-preview-name">@course.Name</span>
                                <span class="course-preview-action" aria-hidden="true">View progress →</span>
                            </a>
                        </li>
                    }
                </ul>
                @if (Model.ActiveCourseCount > Model.ActiveCourses.Count)
                {
                    <p class="dashboard-preview-note">
                        Showing @Model.ActiveCourses.Count of @Model.ActiveCourseCount courses.
                    </p>
                }
            }
            else
            {
                <div class="dashboard-empty-state">
                    <p>You are not enrolled in any active courses yet.</p>
                    <a class="dashboard-panel-link" asp-area="Student" asp-controller="Courses"
                       asp-action="Available">Browse available courses <span aria-hidden="true">→</span></a>
                </div>
            }
        </section>

        <section class="dashboard-panel assignment-section">
            <header class="dashboard-panel-heading">
                <div>
                    <p class="dashboard-section-label">Coming up</p>
                    <h2>Pending assignments</h2>
                </div>
                @if (Model.PendingAssignmentCount > 0)
                {
                    <a class="dashboard-panel-link" asp-area="Student" asp-controller="Assignments"
                       asp-action="All">All assignments <span aria-hidden="true">→</span></a>
                }
            </header>

            @if (Model.PendingAssignments is { Count: > 0 })
            {
                <div class="assignment-table-scroll">
                    <table class="assignment-preview-table">
                        <thead>
                            <tr>
                                <th scope="col">Assignment</th>
                                <th scope="col">Due date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.PendingAssignments)
                            {
                                var daysUntilDue = (assignment.DueDate.Date - DateTime.Today).Days;
                                var dueDateClass = daysUntilDue < 0
                                    ? "is-overdue"
                                    : daysUntilDue <= 3
                                        ? "is-due-soon"
                                        : string.Empty;
                                var dueDateLabel = daysUntilDue < 0
                                    ? "Overdue"
                                    : daysUntilDue == 0
                                        ? "Due today"
                                        : daysUntilDue <= 3
                                            ? "Due soon"
                                            : string.Empty;

                                <tr>
                                    <td data-label="Assignment">
                                        <a class="assignment-preview-title" asp-area="Student"
                                           asp-controller="Assignments" asp-action="Details"
                                           asp-route-id="@assignment.AssignmentId">@assignment.Title</a>
                                    </td>
                                    <td data-label="Due date">
                                        <span class="assignment-due-date @dueDateClass">
                                            @assignment.DueDate.ToString("MMM dd, yyyy")
                                        </span>
                                        @if (!string.IsNullOrEmpty(dueDateLabel))
                                        {
                                            <span class="assignment-due-label @dueDateClass">@dueDateLabel</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.PendingAssignmentCount > Model.PendingAssignments.Count)
                {
                    <p class="dashboard-preview-note">
                        Showing the next @Model.PendingAssignments.Count of @Model.PendingAssignmentCount assignments.
                        <a asp-area="Student" asp-controller="Courses" asp-action="MyCourses">Browse all courses</a>
                        to see their assignments.
                    </p>
                }
            }
            else
            {
                <div class="dashboard-empty-state">
                    <p>You are all caught up—there are no pending assignments.</p>
                </div>
            }
        </section>
    </section>
</main>