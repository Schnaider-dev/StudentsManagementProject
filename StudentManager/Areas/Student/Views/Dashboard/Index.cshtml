@using StudentManager.Models
@model StudentManager.ViewModels.Student.StudentDashboardViewModel

@section Styles {
    <link rel=" stylesheet" href="~/css/dashboard.css" />
}

<h1>Dashboard</h1>

<div class="dashboard-container">
    <section class="summary-cards">
        <div class="card">
            <p>@Model.ActiveCourseCount</p>
            <hr />
            <h4>Active Courses</h4>
        </div>
        <div class="card">
            <p>@Model.PendingAssignmentCount</p>
            <hr />
            <h4>Pending Assignments</h4>
            
        </div>
        <div class="card">
            <p>@Model.GradedAssignmentCount</p>
            <hr />
            <h4>Graded Assigments</h4>
            
        </div>
        <div class="card">
            @if(Model.OverallAveragePercentage is decimal average) {
                <p>@average.ToString("0.##")%</p>
            }
            else {
                <p class="not-graded">Not graded yet</p>
            }
            
            <hr />
            <h4>Your Score</h4>
            
        </div>
    </section>

    <section class="dashboard-content">
        <div
            class="courses-section @(Model.ActiveCourses is not null && Model.ActiveCourses.Any() ? "" : "rm-height")">
            <h3>My Courses</h3>

            @if (Model.ActiveCourses is not null && Model.ActiveCourses.Any())
            {
                foreach (Course course in Model.ActiveCourses)
                {
                    <p class="course">
                        @course.Name @course.Code
                    </p>
                }
                
            }
            else
            {
                <p>No Active Courses</p>
                <a class="no-course" href="/Student/Courses/Available">Register a course</a>
            }
        </div>

        <div class="assignment-section @(Model.PendingAssignments is not null && Model.PendingAssignments.Any() ? "" : "rm-height")">
            <h2>Pending Assignments</h2>
            @if (Model.PendingAssignments is not null && Model.PendingAssignments.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.PendingAssignments)
                        {
                            <tr>
                                <td>@assignment.Title</td>
                                <td>@assignment.DueDate.ToString("MMMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
               <p>No Pending Assignment</p>
            }
            
        </div>
    </section>
</div>