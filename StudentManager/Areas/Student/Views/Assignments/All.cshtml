@model IReadOnlyList<StudentAssignmentViewModel>

@{
    ViewData["Title"] = "All Assignments";
    var submittedCount = Model.Count(assignment => assignment.SubmissionId.HasValue);
    var gradedCount = Model.Count(assignment => assignment.IsGraded);
    var pendingCount = Model.Count - submittedCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-assignments.css" asp-append-version="true" />
}

<div class="student-assignments-page">
    <div class="student-assignments-header">
        <a class="assignments-back-link" asp-area="Student" asp-controller="Dashboard" asp-action="Index">
            <span aria-hidden="true">←</span> Back to dashboard
        </a>
        <p class="assignments-eyebrow">Your coursework</p>
        <h1>All assignments</h1>
        <p class="assignments-subtitle">Assignments from all of your active courses, ordered by due date.</p>
    </div>

    <section class="assignment-summary" aria-label="Assignment summary">
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@Model.Count</span>
            <span class="assignment-summary-label">Total assignments</span>
        </article>
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@pendingCount</span>
            <span class="assignment-summary-label">To submit</span>
        </article>
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@submittedCount</span>
            <span class="assignment-summary-label">Submitted</span>
        </article>
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@gradedCount</span>
            <span class="assignment-summary-label">Graded</span>
        </article>
    </section>

    <section class="assignment-list-section" aria-labelledby="all-assignment-list-heading">
        <div class="assignment-list-heading">
            <div>
                <p class="assignments-eyebrow">Your courses</p>
                <h2 id="all-assignment-list-heading">Assignment list</h2>
            </div>
            <span class="assignment-list-count">@Model.Count assignment(s)</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="assignment-empty-state">
                <h3>No assignments yet</h3>
                <p>Your active courses do not have any assignments right now.</p>
            </div>
        }
        else
        {
            <div class="student-assignment-list">
                @foreach (var assignment in Model)
                {
                    var isOverdue = !assignment.SubmissionId.HasValue &&
                        assignment.DueDate < DateTime.Now;
                    var statusText = assignment.IsGraded
                        ? "Graded"
                        : assignment.SubmissionId.HasValue
                            ? "Submitted"
                            : isOverdue
                                ? "Overdue"
                                : "To submit";
                    var statusClass = assignment.IsGraded
                        ? "assignment-status-graded"
                        : assignment.SubmissionId.HasValue
                            ? "assignment-status-submitted"
                            : isOverdue
                                ? "assignment-status-overdue"
                                : "assignment-status-pending";

                    <article class="student-assignment-card">
                        <div class="student-assignment-main">
                            <p class="all-assignment-course">@assignment.CourseCode · @assignment.CourseName</p>
                            <div class="student-assignment-title-row">
                                <h3>
                                    <a asp-area="Student" asp-controller="Assignments" asp-action="Details"
                                       asp-route-id="@assignment.AssignmentId">@assignment.Title</a>
                                </h3>
                                <span class="assignment-status @statusClass">@statusText</span>
                            </div>
                            <div class="student-assignment-meta">
                                <span>
                                    <strong>Due</strong>
                                    <time datetime="@assignment.DueDate.ToString("O")">
                                        @assignment.DueDate.ToLocalTime().ToString("MMM d, yyyy")
                                    </time>
                                </span>
                                <span><strong>Points</strong> @assignment.MaxPoints.ToString("0.##")</span>
                                @if (assignment.Score is decimal score)
                                {
                                    <span><strong>Score</strong> @score.ToString("0.##") / @assignment.MaxPoints.ToString("0.##")</span>
                                }
                            </div>
                        </div>
                        <a class="assignment-card-action" asp-area="Student" asp-controller="Assignments"
                           asp-action="Details" asp-route-id="@assignment.AssignmentId">
                            View details <span aria-hidden="true">→</span>
                        </a>
                    </article>
                }
            </div>
        }
    </section>
</div>
