@model CourseAssignmentsViewModel

@{
    ViewData["Title"] = "Assignments";
    var submittedCount = Model.Assignments.Count(assignment => assignment.SubmissionId.HasValue);
    var gradedCount = Model.Assignments.Count(assignment => assignment.IsGraded);
    var pendingCount = Model.Assignments.Count - submittedCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-assignments.css" asp-append-version="true" />
}

<div class="student-assignments-page">
    <div class="student-assignments-header">
        <a class="assignments-back-link" asp-area="Student" asp-controller="Courses"
           asp-action="Progress" asp-route-courseId="@Model.CourseId">
            <span aria-hidden="true">←</span> Back to course progress
        </a>
        <p class="assignments-eyebrow">@Model.CourseCode</p>
        <h1>@Model.CourseName</h1>
        <p class="assignments-subtitle">Assignments and your submission progress for this course.</p>
    </div>

    <section class="assignment-summary" aria-label="Assignment summary">
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@Model.Assignments.Count</span>
            <span class="assignment-summary-label">
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-clipboard"></use></svg>
                Total assignments
            </span>
        </article>
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@pendingCount</span>
            <span class="assignment-summary-label">
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-clock"></use></svg>
                To submit
            </span>
        </article>
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@submittedCount</span>
            <span class="assignment-summary-label">
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-upload"></use></svg>
                Submitted
            </span>
        </article>
        <article class="assignment-summary-card">
            <span class="assignment-summary-value">@gradedCount</span>
            <span class="assignment-summary-label">
                <svg class="metric-icon" aria-hidden="true"><use href="#icon-check"></use></svg>
                Graded
            </span>
        </article>
    </section>

    <section class="assignment-list-section" aria-labelledby="assignment-list-heading">
        <div class="assignment-list-heading">
            <div>
                <p class="assignments-eyebrow">Coursework</p>
                <h2 id="assignment-list-heading">Your assignments</h2>
            </div>
            <span class="assignment-list-count">@Model.Assignments.Count assignment(s)</span>
        </div>

        @if (Model.Assignments.Count == 0)
        {
            <div class="assignment-empty-state">
                <h3>No assignments yet</h3>
                <p>There are no active assignments for this course right now.</p>
            </div>
        }
        else
        {
            <div class="student-assignment-list">
                @foreach (var assignment in Model.Assignments)
                {
                    var isOverdue = !assignment.SubmissionId.HasValue &&
                        assignment.DueDate < DateTime.Now;
                    var statusText = assignment.IsGraded
                        ? "Graded"
                        : assignment.SubmissionId.HasValue
                            ? "Submitted"
                            : isOverdue
                                ? "Overdue"
                                : "To submit";
                    var statusClass = assignment.IsGraded
                        ? "assignment-status-graded"
                        : assignment.SubmissionId.HasValue
                            ? "assignment-status-submitted"
                            : isOverdue
                                ? "assignment-status-overdue"
                                : "assignment-status-pending";

                    <article class="student-assignment-card">
                        <div class="student-assignment-main">
                            <div class="student-assignment-title-row">
                                <h3>
                                    <a asp-area="Student" asp-controller="Assignments" asp-action="Details"
                                       asp-route-id="@assignment.AssignmentId">@assignment.Title</a>
                                </h3>
                                <span class="assignment-status @statusClass">@statusText</span>
                            </div>
                            <p class="student-assignment-description">
                                @(string.IsNullOrWhiteSpace(assignment.Description)
                                    ? "No assignment description provided."
                                    : assignment.Description)
                            </p>
                            <div class="student-assignment-meta">
                                <span>
                                    <strong>Due</strong>
                                    <time datetime="@assignment.DueDate.ToString("O")">
                                        @assignment.DueDate.ToLocalTime().ToString("MMM d, yyyy")
                                    </time>
                                </span>
                                <span><strong>Points</strong> @assignment.MaxPoints.ToString("0.##")</span>
                                @if (assignment.SubmittedAt is DateTime submittedAt)
                                {
                                    <span>
                                        <strong>Submitted</strong>
                                        <time datetime="@submittedAt.ToString("O")">
                                            @submittedAt.ToLocalTime().ToString("MMM d, yyyy")
                                        </time>
                                    </span>
                                }
                            </div>
                        </div>
                        <a class="assignment-card-action" asp-area="Student" asp-controller="Assignments"
                           asp-action="Details" asp-route-id="@assignment.AssignmentId">
                            View details <span aria-hidden="true">→</span>
                        </a>
                    </article>
                }
            </div>
        }
    </section>
</div>
