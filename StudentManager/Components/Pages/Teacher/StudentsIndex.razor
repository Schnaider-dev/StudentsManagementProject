@page "/Teacher/Students/{CourseId:int}"
@attribute [Authorize(Roles = "Teacher")]
@inject IProgressService ProgressService
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Students — @model?.CourseCode - StudentManager</PageTitle>

@if (model is not null)
{
    <div class="mb-4">
        <a href="/Teacher/Courses/Details/@model.CourseId" class="text-decoration-none">&larr; @model.CourseName</a>
        <h1 class="mt-2">Students</h1>
        <p class="text-muted mb-0">@model.CourseCode — @model.CourseName</p>
    </div>

    @if (model.Students.Count == 0)
    {
        <div class="alert alert-info" role="status">No students are enrolled in this course.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Student number</th>
                        <th scope="col">Email</th>
                        <th scope="col">Enrolled</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Graded</th>
                        <th scope="col">Average</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in model.Students)
                    {
                        <tr>
                            <td>@student.StudentName</td>
                            <td>@(string.IsNullOrWhiteSpace(student.StudentNumber) ? "—" : student.StudentNumber)</td>
                            <td><a href="mailto:@student.Email">@student.Email</a></td>
                            <td><time datetime="@student.EnrolledAt.ToString("O")">@student.EnrolledAt.ToLocalTime().ToString("d")</time></td>
                            <td>@student.SubmittedAssignmentCount</td>
                            <td>@student.GradedAssignmentCount</td>
                            <td>@(student.AveragePercentage.HasValue ? $"{student.AveragePercentage.Value:F1}%" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int CourseId { get; set; }

    private CourseStudentsViewModel? model;

    protected override async Task OnInitializedAsync()
    {
        var teacherId = await CurrentUser.GetUserIdAsync();

        if (teacherId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        model = await ProgressService.GetCourseStudentsAsync(CourseId, teacherId);

        if (model is null)
        {
            Navigation.NotFound();
        }
    }
}
