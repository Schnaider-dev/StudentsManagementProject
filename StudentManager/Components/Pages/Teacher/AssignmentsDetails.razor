@page "/Teacher/Assignments/Details/{Id:int}"
@attribute [Authorize(Roles = "Teacher")]
@inject IAssignmentService AssignmentService
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>@(assignment?.Title ?? "Assignment") - StudentManager</PageTitle>

@if (assignment is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a href="/Teacher/Assignments/@assignment.CourseId" class="text-decoration-none">&larr; @assignment.Course.Name assignments</a>
            <h1 class="mt-2">@assignment.Title</h1>
            <p class="text-muted mb-0">@assignment.Course.Code — @assignment.Course.Name</p>
        </div>
        <div class="d-flex gap-2">
            @if (assignment.IsActive)
            {
                <a href="/Teacher/Assignments/Edit/@assignment.AssignmentId" class="btn btn-outline-secondary">Edit</a>
            }
            <a href="/Teacher/Grades/@assignment.AssignmentId" class="btn btn-primary">Review submissions</a>
            <a href="/Teacher/Assignments/Delete/@assignment.AssignmentId" class="btn btn-outline-danger">Archive</a>
        </div>
    </div>

    <section class="mb-4" aria-labelledby="assignment-details-heading">
        <h2 id="assignment-details-heading" class="h4">Assignment details</h2>
        <dl class="row">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(assignment.Description) ? "No description provided." : assignment.Description)</dd>
            <dt class="col-sm-3">Due date</dt>
            <dd class="col-sm-9"><time datetime="@assignment.DueDate.ToString("O")">@assignment.DueDate.ToLocalTime().ToString("f")</time></dd>
            <dt class="col-sm-3">Maximum points</dt>
            <dd class="col-sm-9">@assignment.MaxPoints</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(assignment.IsActive ? "Active" : "Archived")</dd>
        </dl>
    </section>

    <section aria-labelledby="submissions-heading">
        <h2 id="submissions-heading" class="h4">Submissions <span class="text-muted">(@assignment.Submissions.Count)</span></h2>
        @if (assignment.Submissions.Count == 0)
        {
            <p class="text-muted">No submissions have been received.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Student</th>
                            <th scope="col">Submitted</th>
                            <th scope="col">Status</th>
                            <th scope="col">Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in assignment.Submissions.OrderBy(item => item.Student.LastName).ThenBy(item => item.Student.FirstName))
                        {
                            <tr>
                                <td>@submission.Student.FirstName @submission.Student.LastName</td>
                                <td><time datetime="@submission.SubmittedAt.ToString("O")">@submission.SubmittedAt.ToLocalTime().ToString("g")</time></td>
                                <td>@(submission.IsLate ? "Late" : "On time")</td>
                                <td>
                                    @if (submission.Grade is null)
                                    {
                                        <span class="text-muted">Not graded</span>
                                    }
                                    else
                                    {
                                        <span>@submission.Grade.Score / @assignment.MaxPoints</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Assignment? assignment;

    protected override async Task OnInitializedAsync()
    {
        var teacherId = await CurrentUser.GetUserIdAsync();

        if (teacherId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        assignment = await AssignmentService.GetTeacherAssignmentAsync(Id, teacherId);

        if (assignment is null)
        {
            Navigation.NotFound();
        }
    }
}
