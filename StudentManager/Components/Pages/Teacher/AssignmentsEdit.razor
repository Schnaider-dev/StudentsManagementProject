@page "/Teacher/Assignments/Edit/{Id:int}"
@attribute [Authorize(Roles = "Teacher")]
@inject IAssignmentService AssignmentService
@inject CurrentUserService CurrentUser
@inject FlashService Flash
@inject NavigationManager Navigation

<PageTitle>Edit Assignment - StudentManager</PageTitle>

<h1>Edit assignment</h1>
<p class="text-muted">For @courseName</p>

<EditForm Model="Model" FormName="edit-assignment" OnValidSubmit="SubmitAsync" Enhance class="mt-4">
    <DataAnnotationsValidator />
    @if (errorMessage is not null)
    {
        <div class="text-danger" role="alert">@errorMessage</div>
    }
    <div class="mb-3">
        <label for="assignment-title" class="form-label">Title</label>
        <InputText id="assignment-title" class="form-control" @bind-Value="Model.Title" />
        <ValidationMessage For="() => Model.Title" class="text-danger" />
    </div>
    <div class="mb-3">
        <label for="assignment-description" class="form-label">Description</label>
        <InputTextArea id="assignment-description" class="form-control" rows="5" @bind-Value="Model.Description" />
        <ValidationMessage For="() => Model.Description" class="text-danger" />
    </div>
    <div class="mb-3">
        <label for="assignment-due" class="form-label">Due Date</label>
        <InputDate id="assignment-due" Type="InputDateType.DateTimeLocal" step="1" class="form-control" @bind-Value="Model.DueDate" />
        <ValidationMessage For="() => Model.DueDate" class="text-danger" />
    </div>
    <div class="mb-3">
        <label for="assignment-points" class="form-label">Maximum Points</label>
        <InputNumber id="assignment-points" step="0.01" class="form-control" @bind-Value="Model.MaxPoints" />
        <ValidationMessage For="() => Model.MaxPoints" class="text-danger" />
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="/Teacher/Assignments/Details/@Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromForm]
    private AssignmentEditViewModel Model { get; set; } = default!;

    private string courseName = "Course";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var teacherId = await CurrentUser.GetUserIdAsync();

        if (teacherId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        var assignment = await AssignmentService.GetTeacherAssignmentAsync(Id, teacherId);

        if (assignment is null || !assignment.IsActive)
        {
            Navigation.NotFound();
            return;
        }

        courseName = assignment.Course.Name;
        Model ??= new AssignmentEditViewModel
        {
            Title = assignment.Title,
            Description = assignment.Description,
            DueDate = assignment.DueDate,
            MaxPoints = assignment.MaxPoints
        };
        // Ids come from the route and database, so they are in place before validation runs.
        Model.AssignmentId = Id;
        Model.CourseId = assignment.CourseId;
    }

    private async Task SubmitAsync()
    {
        var teacherId = await CurrentUser.GetUserIdAsync();

        if (teacherId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        Model.AssignmentId = Id;

        try
        {
            if (!await AssignmentService.UpdateAssignmentAsync(Model, teacherId))
            {
                Navigation.NotFound();
                return;
            }

            Flash.Success("Assignment was updated successfully.");
            Navigation.NavigateTo($"/Teacher/Assignments/Details/{Id}");
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
    }
}
