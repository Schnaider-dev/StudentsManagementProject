@page "/Teacher/Courses"
@attribute [Authorize(Roles = "Teacher")]
@inject ICourseService CourseService
@inject CurrentUserService CurrentUser

<PageTitle>My Courses - StudentManager</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>My Courses</h1>
        <p class="text-muted mb-0">Manage your courses, students, and assignments.</p>
    </div>
    <a href="/Teacher/Courses/Create" class="btn btn-primary">Create course</a>
</div>

@if (courses is null)
{
    <p role="status">Loading courses…</p>
}
else if (courses.Count == 0)
{
    <div class="alert alert-info" role="status">
        You don't have any courses yet.
        <a href="/Teacher/Courses/Create" class="alert-link">Create your first course</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Course</th>
                    <th scope="col">Students</th>
                    <th scope="col">Assignments</th>
                    <th scope="col">Created</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in courses)
                {
                    <tr>
                        <td>@course.Code</td>
                        <td><a href="/Teacher/Courses/Details/@course.CourseId">@course.Name</a></td>
                        <td>@course.Enrollments.Count</td>
                        <td>@course.Assignments.Count</td>
                        <td><time datetime="@course.CreatedAt.ToString("O")">@course.CreatedAt.ToLocalTime().ToString("d")</time></td>
                        <td class="text-nowrap">
                            <a href="/Teacher/Courses/Edit/@course.CourseId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a href="/Teacher/Students/@course.CourseId" class="btn btn-sm btn-outline-secondary">Students</a>
                            <a href="/Teacher/Assignments/@course.CourseId" class="btn btn-sm btn-outline-primary">Assignments</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Course>? courses;

    protected override async Task OnInitializedAsync()
    {
        var teacherId = await CurrentUser.GetUserIdAsync();

        courses = teacherId is null
            ? Array.Empty<Course>()
            : await CourseService.GetTeacherCoursesAsync(teacherId);
    }
}
