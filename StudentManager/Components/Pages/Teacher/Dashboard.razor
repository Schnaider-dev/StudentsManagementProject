@page "/Teacher/Dashboard"
@attribute [Authorize(Roles = "Teacher")]
@inject IProgressService ProgressService
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>My Dashboard - StudentManager</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/dashboard.css" />
</HeadContent>

@if (model is not null)
{
    var toGrade = model.UngradedSubmissionCount;

    <header class="dashboard-page-heading">
        <h1>My Dashboard</h1>
    </header>

    <div class="dashboard-container">
        <section class="summary-cards" aria-label="Your teaching summary">
            <DashboardStatCard Value="@model.ActiveCourseCount.ToString()" Label="Active courses" Icon="icon-book" />
            <DashboardStatCard Value="@model.ActiveStudentCount.ToString()" Label="Active students" Icon="icon-users" />
            <DashboardStatCard Value="@model.ActiveAssignmentCount.ToString()" Label="Active assignments" Icon="icon-clipboard" />
            <DashboardStatCard Value="@toGrade.ToString()" Label="Submissions to grade" Icon="icon-message-clock" />
        </section>

        <div class="dashboard-content">
            <section class="dashboard-panel">
                <header class="dashboard-panel-heading">
                    <div>
                        <p class="dashboard-section-label">Needs attention</p>
                        <h2>Grading</h2>
                    </div>
                </header>

                <div class="dashboard-empty-state">
                    @if (toGrade > 0)
                    {
                        <p>
                            @(toGrade == 1
                                ? "1 submission is waiting for a grade."
                                : $"{toGrade} submissions are waiting for a grade.")
                            Open a course and choose an assignment to grade its submissions.
                        </p>
                        <a class="dashboard-panel-link" href="/Teacher/Courses">Go to my courses <span aria-hidden="true">→</span></a>
                    }
                    else
                    {
                        <p>You are all caught up—there is nothing to grade.</p>
                    }
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-heading">
                    <div>
                        <p class="dashboard-section-label">Your teaching</p>
                        <h2>Courses</h2>
                    </div>
                    @if (model.ActiveCourseCount > 0)
                    {
                        <a class="dashboard-panel-link" href="/Teacher/Courses">All courses <span aria-hidden="true">→</span></a>
                    }
                </header>

                <div class="dashboard-empty-state">
                    @if (model.ActiveCourseCount > 0)
                    {
                        <p>Manage your courses, their students, and assignments, or start a new course.</p>
                    }
                    else
                    {
                        <p>You don't have any active courses yet.</p>
                    }
                    <a class="btn btn-primary" href="/Teacher/Courses/Create">Create course</a>
                </div>
            </section>
        </div>
    </div>
}

@code {
    private TeacherDashboardViewModel? model;

    protected override async Task OnInitializedAsync()
    {
        var teacherId = await CurrentUser.GetUserIdAsync();

        if (teacherId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        model = await ProgressService.GetTeacherDashboardAsync(teacherId);
    }
}
