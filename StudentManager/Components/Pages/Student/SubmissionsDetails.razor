@page "/Student/Submissions/Details/{Id:int}"
@attribute [Authorize(Roles = "Student")]
@inject ISubmissionService SubmissionService
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Submission Details - StudentManager</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/submission-details.css" />
</HeadContent>

@if (submission is not null)
{
    var assignment = submission.Assignment;
    var isGraded = submission.Grade is not null;

    <div class="submission-details-page">
        <div class="submission-details-header">
            <a class="submission-details-back-link" href="/Student/Assignments/Details/@submission.AssignmentId">
                <span aria-hidden="true">←</span> Back to assignment
            </a>
            <p class="submission-details-eyebrow">@assignment.Course.Code · @assignment.Course.Name</p>
            <div class="submission-details-title-row">
                <div>
                    <p class="submission-details-kicker">Submission receipt</p>
                    <h1>@assignment.Title</h1>
                </div>
                @if (isGraded)
                {
                    <span class="submission-details-status submission-details-status-graded">Graded</span>
                }
                else if (submission.IsLate)
                {
                    <span class="submission-details-status submission-details-status-late">Submitted late</span>
                }
                else
                {
                    <span class="submission-details-status submission-details-status-submitted">Submitted</span>
                }
            </div>
        </div>

        <section class="submission-receipt" aria-label="Submission information">
            <div class="submission-receipt-item">
                <span>Submitted</span>
                <time datetime="@submission.SubmittedAt.ToString("O")">
                    @submission.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy")
                </time>
            </div>
            <div class="submission-receipt-item">
                <span>Due date</span>
                <time datetime="@assignment.DueDate.ToString("O")">
                    @assignment.DueDate.ToLocalTime().ToString("MMM d, yyyy")
                </time>
            </div>
            @if (submission.UpdatedAt is DateTime updatedAt)
            {
                <div class="submission-receipt-item">
                    <span>Last updated</span>
                    <time datetime="@updatedAt.ToString("O")">
                        @updatedAt.ToLocalTime().ToString("MMM d, yyyy")
                    </time>
                </div>
            }
            <div class="submission-receipt-item">
                <span>Points possible</span>
                <strong>@assignment.MaxPoints.ToString("0.##")</strong>
            </div>
            @if (submission.Grade is not null)
            {
                <div class="submission-receipt-item submission-receipt-score">
                    <span>Score</span>
                    <strong>@submission.Grade.Score.ToString("0.##") / @assignment.MaxPoints.ToString("0.##")</strong>
                </div>
            }
        </section>

        <section class="submission-document" aria-labelledby="submitted-work-heading">
            <div class="submission-document-heading">
                <p class="submission-details-eyebrow">Submitted work</p>
                <h2 id="submitted-work-heading">Your response</h2>
            </div>
            <div class="submission-details-content">@submission.Content</div>
        </section>

        @if (submission.Grade is not null && !string.IsNullOrWhiteSpace(submission.Grade.Feedback))
        {
            <section class="submission-review" aria-labelledby="submission-feedback-heading">
                <div class="submission-document-heading">
                    <p class="submission-details-eyebrow">Instructor review</p>
                    <h2 id="submission-feedback-heading">Feedback</h2>
                </div>
                <p>@submission.Grade.Feedback</p>
            </section>
        }

        <div class="submission-details-footer">
            @if (isGraded)
            {
                <p>This submission has been graded and can no longer be edited.</p>
            }
            else
            {
                <p>You can update your response until it has been graded.</p>
                <a class="submission-details-edit-link" href="/Student/Submissions/Edit/@submission.SubmissionId">
                    Edit submission <span aria-hidden="true">→</span>
                </a>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Submission? submission;

    protected override async Task OnInitializedAsync()
    {
        var studentId = await CurrentUser.GetUserIdAsync();

        if (studentId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        submission = await SubmissionService.GetSubmissionAsync(Id, studentId);

        if (submission is null)
        {
            Navigation.NotFound();
        }
    }
}
