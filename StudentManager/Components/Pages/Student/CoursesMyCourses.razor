@page "/Student/Courses/MyCourses"
@attribute [Authorize(Roles = "Student")]
@inject IEnrollmentService EnrollmentService
@inject CurrentUserService CurrentUser
@inject FlashService Flash
@inject NavigationManager Navigation

<PageTitle>My Courses - StudentManager</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/mycourses.css" />
</HeadContent>

<div class="courses-page-heading">
    <div class="courses-page-title">
        <a class="courses-dashboard-link" href="/Student/Dashboard">
            <span aria-hidden="true">&larr;</span> Back to dashboard
        </a>
        <h1>My Courses</h1>
    </div>
    @if (courses is { Count: > 0 })
    {
        <a href="/Student/Courses/Available" class="courses-browse-link">
            Browse courses <span aria-hidden="true">&rarr;</span>
        </a>
    }
</div>

@if (courses is null)
{
}
else if (courses.Count == 0)
{
    <section class="courses-empty-state" aria-labelledby="courses-empty-state-title">
        <span class="courses-empty-state-mark" aria-hidden="true">+</span>
        <p class="courses-empty-state-eyebrow">Your learning journey</p>
        <h2 id="courses-empty-state-title">Your next course is waiting</h2>
        <p>You&rsquo;re not enrolled in any courses yet. Explore the course catalog to find one that interests you.</p>
        <a href="/Student/Courses/Available" class="courses-empty-state-link">
            Explore available courses <span aria-hidden="true">&rarr;</span>
        </a>
    </section>
}
else
{
    <div class="courses-list accordion" id="myCoursesAccordion">
        @foreach (var course in courses)
        {
            <div class="course-card accordion-item">
                <div class="course-header accordion-header" id="heading-@course.CourseId">
                    <h2>
                        <button class="accordion-button collapsed" data-bs-toggle="collapse" type="button"
                                data-bs-target="#collapse-@course.CourseId" aria-expanded="false"
                                aria-controls="collapse-@course.CourseId">
                            (@course.Code) @course.Name
                        </button>
                    </h2>
                </div>
                <div id="collapse-@course.CourseId" class="accordion-collapse collapse"
                     aria-labelledby="heading-@course.CourseId" data-bs-parent="#myCoursesAccordion">
                    <div class="accordion-body">
                        <div class="left-side">
                            <p><strong>Teacher:</strong> @course.TeacherName</p>
                            <p><strong>Description:</strong> @course.Description</p>
                            <p><strong>Assignment(s):</strong> @course.AssignmentCount</p>
                            <p><strong>Enrolled:</strong> @course.EnrolledAt.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="view-details">
                            <a href="/Student/Courses/Progress/@course.CourseId">View progress</a>
                            <a href="/Student/Assignments/Index/@course.CourseId">View assignments</a>
                            <button type="button" class="course-drop-button" data-dialog-id="dialogBox-@course.CourseId">Drop course</button>
                        </div>
                    </div>
                </div>
            </div>
            <dialog class="course-drop-dialog" id="dialogBox-@course.CourseId"
                    aria-labelledby="drop-dialog-title-@course.CourseId">
                <div class="course-drop-dialog-content">
                    <p class="course-drop-dialog-eyebrow">Course enrollment</p>
                    <h2 id="drop-dialog-title-@course.CourseId">Drop this course?</h2>
                    <p class="course-drop-dialog-course">
                        <strong>@course.Code</strong> &middot; @course.Name
                    </p>
                    <p class="course-drop-dialog-message">
                        Dropping this course will remove it from your course list. This action cannot be undone.
                    </p>
                </div>
                <div class="dialog-footer">
                    <button type="button" class="cancel-dialog">Keep course</button>
                    <form method="post" @formname="@($"drop-{course.CourseId}")" @onsubmit="() => DropAsync(course.CourseId)" data-enhance>
                        <AntiforgeryToken />
                        <button type="submit" class="course-drop-confirm-button">Drop course</button>
                    </form>
                </div>
            </dialog>
        }
    </div>
}

@code {
    private List<MyCourseViewModel>? courses;
    private string? studentId;

    protected override async Task OnInitializedAsync()
    {
        studentId = await CurrentUser.GetUserIdAsync();

        if (studentId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        courses = (await EnrollmentService.GetStudentCoursesAsync(studentId)).ToList();
    }

    private async Task DropAsync(int courseId)
    {
        // The owner always comes from the signed-in account, never from posted data.
        var dropped = await EnrollmentService.DropAsync(courseId, studentId!);

        if (dropped)
        {
            Flash.Success("The course was dropped successfully.");
        }
        else
        {
            Flash.Error("The active enrollment was not found.");
        }

        Navigation.NavigateTo("/Student/Courses/MyCourses");
    }
}
