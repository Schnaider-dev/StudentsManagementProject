@using StudentManager.Components.Shared
@page "/Student/Assignments/All"
@attribute [Authorize(Roles = "Student")]
@inject ISubmissionService SubmissionService
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>All Assignments - StudentManager</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/student-assignments.css" />
</HeadContent>

@if (assignments is not null)
{
    var submittedCount = assignments.Count(assignment => assignment.SubmissionId.HasValue);
    var gradedCount = assignments.Count(assignment => assignment.IsGraded);
    var pendingCount = assignments.Count - submittedCount;

    <div class="student-assignments-page">
        <div class="student-assignments-header">
            <a class="assignments-back-link" href="/Student/Dashboard">
                <span aria-hidden="true">←</span> Back to dashboard
            </a>
            <p class="assignments-eyebrow">Your coursework</p>
            <h1>All assignments</h1>
            <p class="assignments-subtitle">Assignments from all of your active courses, ordered by due date.</p>
        </div>

        <AssignmentSummary Total="assignments.Count" Pending="pendingCount" Submitted="submittedCount" Graded="gradedCount" />

        <section class="assignment-list-section" aria-labelledby="all-assignment-list-heading">
            <div class="assignment-list-heading">
                <div>
                    <p class="assignments-eyebrow">Your courses</p>
                    <h2 id="all-assignment-list-heading">Assignment list</h2>
                </div>
                <span class="assignment-list-count">@assignments.Count assignment(s)</span>
            </div>

            @if (assignments.Count == 0)
            {
                <div class="assignment-empty-state">
                    <h3>No assignments yet</h3>
                    <p>Your active courses do not have any assignments right now.</p>
                </div>
            }
            else
            {
                <div class="student-assignment-list">
                    @foreach (var assignment in assignments)
                    {
                        var (statusText, statusClass) = AssignmentSummary.Status(assignment);

                        <article class="student-assignment-card">
                            <div class="student-assignment-main">
                                <p class="all-assignment-course">@assignment.CourseCode · @assignment.CourseName</p>
                                <div class="student-assignment-title-row">
                                    <h3>
                                        <a href="/Student/Assignments/Details/@assignment.AssignmentId">@assignment.Title</a>
                                    </h3>
                                    <span class="assignment-status @statusClass">@statusText</span>
                                </div>
                                <div class="student-assignment-meta">
                                    <span>
                                        <strong>Due</strong>
                                        <time datetime="@assignment.DueDate.ToString("O")">
                                            @assignment.DueDate.ToLocalTime().ToString("MMM d, yyyy")
                                        </time>
                                    </span>
                                    <span><strong>Points</strong> @assignment.MaxPoints.ToString("0.##")</span>
                                    @if (assignment.Score is decimal score)
                                    {
                                        <span><strong>Score</strong> @score.ToString("0.##") / @assignment.MaxPoints.ToString("0.##")</span>
                                    }
                                </div>
                            </div>
                            <a class="assignment-card-action" href="/Student/Assignments/Details/@assignment.AssignmentId">
                                View details <span aria-hidden="true">→</span>
                            </a>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private IReadOnlyList<StudentAssignmentViewModel>? assignments;

    protected override async Task OnInitializedAsync()
    {
        var studentId = await CurrentUser.GetUserIdAsync();

        if (studentId is null)
        {
            Navigation.NavigateTo("/Identity/Account/Login", forceLoad: true);
            return;
        }

        assignments = await SubmissionService.GetAllAssignmentsAsync(studentId);
    }
}
