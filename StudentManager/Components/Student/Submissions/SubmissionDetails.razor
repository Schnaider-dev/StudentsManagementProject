@page "/blazor/student/submissions/{SubmissionId:int}"
@attribute [Authorize(Roles = "Student")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ISubmissionService SubmissionService
@inject ILogger<SubmissionDetails> Logger

<PageTitle>@(_submission?.Assignment.Title ?? "Submission") - StudentManager</PageTitle>
<div class="submission-details-page">
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (_submission is null)
    {
        <p role="status">Loading submission…</p>
    }
    else
    {
        var assignment = _submission.Assignment;
        <div class="submission-details-header">
            <a class="submission-details-back-link" href="@($"/blazor/student/assignments/{assignment.AssignmentId}")">← Back to assignment</a>
            <p class="submission-details-eyebrow">@assignment.Course.Code · @assignment.Course.Name</p>
            <div class="submission-details-title-row">
                <div><p class="submission-details-kicker">Submission receipt</p><h1>@assignment.Title</h1></div>
                <span class="submission-details-status @(_submission.Grade is not null ? "submission-details-status-graded" : _submission.IsLate ? "submission-details-status-late" : "submission-details-status-submitted")">
                    @(_submission.Grade is not null ? "Graded" : _submission.IsLate ? "Submitted late" : "Submitted")
                </span>
            </div>
        </div>
        <section class="submission-receipt" aria-label="Submission information">
            <div class="submission-receipt-item"><span>Submitted</span><time datetime="@_submission.SubmittedAt.ToString("O")">@_submission.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy")</time></div>
            <div class="submission-receipt-item"><span>Due date</span><time datetime="@assignment.DueDate.ToString("O")">@assignment.DueDate.ToLocalTime().ToString("MMM d, yyyy")</time></div>
            @if (_submission.UpdatedAt is DateTime updatedAt)
            {
                <div class="submission-receipt-item"><span>Last updated</span><time datetime="@updatedAt.ToString("O")">@updatedAt.ToLocalTime().ToString("MMM d, yyyy")</time></div>
            }
            <div class="submission-receipt-item"><span>Points possible</span><strong>@assignment.MaxPoints.ToString("0.##")</strong></div>
            @if (_submission.Grade is not null)
            {
                <div class="submission-receipt-item submission-receipt-score"><span>Score</span><strong>@_submission.Grade.Score.ToString("0.##") / @assignment.MaxPoints.ToString("0.##")</strong></div>
            }
        </section>
        <section class="submission-document" aria-labelledby="submitted-work-heading">
            <div class="submission-document-heading"><p class="submission-details-eyebrow">Submitted work</p><h2 id="submitted-work-heading">Your response</h2></div>
            <div class="submission-details-content">@_submission.Content</div>
        </section>
        @if (_submission.Grade is not null && !string.IsNullOrWhiteSpace(_submission.Grade.Feedback))
        {
            <section class="submission-review" aria-labelledby="feedback-heading">
                <div class="submission-document-heading"><p class="submission-details-eyebrow">Instructor review</p><h2 id="feedback-heading">Feedback</h2></div>
                <p>@_submission.Grade.Feedback</p>
            </section>
        }
        <footer class="submission-details-footer">
            @if (_submission.Grade is not null)
            {
                <p>This submission has been graded and can no longer be edited.</p>
            }
            else
            {
                <p>You can update your response until it has been graded.</p>
                <a class="submission-details-edit-link" href="@($"/blazor/student/submissions/{SubmissionId}/edit")">Edit submission <span aria-hidden="true">→</span></a>
            }
        </footer>
    }
</div>

@code {
    [Parameter] public int SubmissionId { get; set; }
    private Submission? _submission;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var studentId = UserManager.GetUserId(principal);
        if (studentId is null) throw new InvalidOperationException("The signed-in student account could not be identified.");
        _submission = null;
        _error = null;
        try
        {
            _submission = await SubmissionService.GetSubmissionAsync(SubmissionId, studentId);
            if (_submission is null) _error = "That submission could not be found.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load submission {SubmissionId} for student {StudentId}.", SubmissionId, studentId);
            _error = "Submission details couldn't be loaded. Please try again.";
        }
    }
}
