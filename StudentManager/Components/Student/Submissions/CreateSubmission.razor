@page "/blazor/student/assignments/{AssignmentId:int}/submit"
@attribute [Authorize(Roles = "Student")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ISubmissionService SubmissionService
@inject NavigationManager Navigation
@inject ILogger<CreateSubmission> Logger

<PageTitle>Submit Assignment - StudentManager</PageTitle>
<div class="student-assignments-page">
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (_model is null)
    {
        <p role="status">Loading assignment…</p>
    }
    else
    {
        <div class="submission-form-header">
            <a class="submission-back-link" href="@($"/blazor/student/assignments/{AssignmentId}")">← Back to assignment</a>
            <p class="submission-eyebrow">Assignment submission</p>
            <h1>@_model.AssignmentTitle</h1>
            <p class="submission-intro">Write your response below, then review it before submitting.</p>
        </div>
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <SubmissionEditor Model="_model" IsSaving="_isSaving"
                              HelpText="You can edit your response later if it has not been graded." />
        </EditForm>
    }
</div>

@code {
    [Parameter] public int AssignmentId { get; set; }
    private SubmissionViewModel? _model;
    private string? _error;
    private string? _studentId;
    private bool _isSaving;

    protected override async Task OnParametersSetAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _studentId = UserManager.GetUserId(principal);
        if (_studentId is null) throw new InvalidOperationException("The signed-in student account could not be identified.");
        _model = null;
        _error = null;
        var assignment = await SubmissionService.GetAssignmentAsync(AssignmentId, _studentId);
        if (assignment is null)
        {
            _error = "That assignment could not be found.";
        }
        else if (assignment.SubmissionId is int existingId)
        {
            Navigation.NavigateTo($"/blazor/student/submissions/{existingId}");
        }
        else
        {
            _model = new SubmissionViewModel { AssignmentId = assignment.AssignmentId, AssignmentTitle = assignment.Title };
        }
    }

    private async Task SubmitAsync()
    {
        if (_model is null || _studentId is null) return;
        _isSaving = true;
        _error = null;
        try
        {
            var submission = await SubmissionService.CreateSubmissionAsync(_model, _studentId);
            Navigation.NavigateTo($"/blazor/student/submissions/{submission.SubmissionId}");
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to submit assignment {AssignmentId} for student {StudentId}.", AssignmentId, _studentId);
            _error = "Your submission couldn't be saved. Please try again.";
        }
        finally { _isSaving = false; }
    }
}
