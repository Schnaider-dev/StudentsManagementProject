@page "/student/assignments/{AssignmentId:int}"
@attribute [Authorize(Roles = "Student")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ISubmissionService SubmissionService
@inject ILogger<AssignmentDetails> Logger

<PageTitle>@(_assignment?.Title ?? "Assignment") - StudentManager</PageTitle>
<div class="student-assignments-page">
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (_assignment is null)
    {
        <p role="status">Loading assignment…</p>
    }
    else
    {
        <div class="student-assignments-header">
            <a class="assignments-back-link" href="/student/assignments">← All assignments</a>
            <p class="assignments-eyebrow">@_assignment.CourseCode · @_assignment.CourseName</p>
            <h1>@_assignment.Title</h1>
            <p class="assignments-subtitle">Due @_assignment.DueDate.ToLocalTime().ToString("f") · @_assignment.MaxPoints.ToString("0.##") points</p>
        </div>
        <section class="assignment-list-section">
            <h2>Assignment details</h2>
            <p>@(string.IsNullOrWhiteSpace(_assignment.Description) ? "No assignment description provided." : _assignment.Description)</p>
            @if (_assignment.IsGraded)
            {
                <p><strong>Score:</strong> @(_assignment.Score?.ToString("0.##") ?? "-") / @_assignment.MaxPoints.ToString("0.##")</p>
                @if (!string.IsNullOrWhiteSpace(_assignment.Feedback))
                {
                    <h3>Instructor feedback</h3>
                    <p>@_assignment.Feedback</p>
                }
            }
        </section>
        <section class="assignment-list-section mt-3">
            <h2>Your submission</h2>
            @if (_assignment.SubmissionId is int submissionId)
            {
                <p>@(_assignment.IsGraded ? "This assignment has been graded." : "Your work has been submitted and is awaiting a grade.")</p>
                <a class="assignment-primary-action" href="@($"/student/submissions/{submissionId}")">View submission</a>
                @if (!_assignment.IsGraded)
                {
                    <a class="assignment-secondary-action ms-2" href="@($"/student/submissions/{submissionId}/edit")">Edit submission</a>
                }
            }
            else
            {
                <p>@(_assignment.DueDate < DateTime.Now ? "This assignment is past its due date, but you can still submit your work." : "You have not submitted this assignment yet.")</p>
                <a class="assignment-primary-action" href="@($"/student/assignments/{_assignment.AssignmentId}/submit")">Submit assignment</a>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int AssignmentId { get; set; }
    private StudentAssignmentViewModel? _assignment;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var studentId = UserManager.GetUserId(principal);
        if (studentId is null)
        {
            throw new InvalidOperationException("The signed-in student account could not be identified.");
        }

        _assignment = null;
        _error = null;
        try
        {
            _assignment = await SubmissionService.GetAssignmentAsync(AssignmentId, studentId);
            if (_assignment is null)
            {
                _error = "That assignment could not be found.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load assignment {AssignmentId} for student {StudentId}.", AssignmentId, studentId);
            _error = "Assignment details couldn't be loaded. Please try again.";
        }
    }
}
