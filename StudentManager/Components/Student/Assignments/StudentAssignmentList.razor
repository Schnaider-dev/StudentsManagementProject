@if (Assignments.Count == 0)
{
    <div class="assignment-empty-state">
        <h3>No assignments yet</h3>
        <p>@EmptyMessage</p>
    </div>
}
else
{
    <div class="student-assignment-list">
        @foreach (var assignment in Assignments)
        {
            var isOverdue = !assignment.SubmissionId.HasValue && assignment.DueDate < DateTime.Now;
            var status = assignment.IsGraded
                ? ("Graded", "assignment-status-graded")
                : assignment.SubmissionId.HasValue
                    ? ("Submitted", "assignment-status-submitted")
                    : isOverdue
                        ? ("Overdue", "assignment-status-overdue")
                        : ("To submit", "assignment-status-pending");

            <article class="student-assignment-card">
                <div class="student-assignment-main">
                    @if (ShowCourse)
                    {
                        <p class="all-assignment-course">@assignment.CourseCode · @assignment.CourseName</p>
                    }
                    <div class="student-assignment-title-row">
                        <h3><a href="@($"/student/assignments/{assignment.AssignmentId}")">@assignment.Title</a></h3>
                        <span class="assignment-status @status.Item2">@status.Item1</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(assignment.Description))
                    {
                        <p class="student-assignment-description">@assignment.Description</p>
                    }
                    <div class="student-assignment-meta">
                        <span><strong>Due</strong> <time datetime="@assignment.DueDate.ToString("O")">@assignment.DueDate.ToLocalTime().ToString("MMM d, yyyy")</time></span>
                        <span><strong>Points</strong> @assignment.MaxPoints.ToString("0.##")</span>
                        @if (assignment.SubmittedAt is DateTime submittedAt)
                        {
                            <span><strong>Submitted</strong> <time datetime="@submittedAt.ToString("O")">@submittedAt.ToLocalTime().ToString("MMM d, yyyy")</time></span>
                        }
                        @if (assignment.Score is decimal score)
                        {
                            <span><strong>Score</strong> @score.ToString("0.##") / @assignment.MaxPoints.ToString("0.##")</span>
                        }
                    </div>
                </div>
                <a class="assignment-card-action" href="@($"/student/assignments/{assignment.AssignmentId}")">
                    View details <span aria-hidden="true">→</span>
                </a>
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<StudentAssignmentViewModel> Assignments { get; set; } = Array.Empty<StudentAssignmentViewModel>();

    [Parameter]
    public bool ShowCourse { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "There are no active assignments right now.";
}
