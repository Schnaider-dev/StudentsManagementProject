@if (Page.TotalPages > 1)
{
    var firstPage = Math.Max(1, Page.CurrentPage - 2);
    var lastPage = Math.Min(Page.TotalPages, firstPage + 4);
    firstPage = Math.Max(1, lastPage - 4);

    <nav aria-label="Course pages" class="course-pagination">
        <ul class="course-pagination-list">
            <li class="course-pagination-item @(Page.HasPreviousPage ? "" : "is-disabled")">
                @if (Page.HasPreviousPage)
                {
                    <button type="button" class="course-page-link" aria-label="Previous page"
                            @onclick="() => OnPageChanged.InvokeAsync(Page.CurrentPage - 1)">
                        Previous
                    </button>
                }
                else
                {
                    <span class="course-page-link" aria-disabled="true">Previous</span>
                }
            </li>

            @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
            {
                var selectedPage = pageNumber;
                <li class="course-pagination-item @(selectedPage == Page.CurrentPage ? "is-current" : "")">
                    <button type="button" class="course-page-link"
                            aria-current="@(selectedPage == Page.CurrentPage ? "page" : null)"
                            @onclick="() => OnPageChanged.InvokeAsync(selectedPage)">
                        @selectedPage
                    </button>
                </li>
            }

            <li class="course-pagination-item @(Page.HasNextPage ? "" : "is-disabled")">
                @if (Page.HasNextPage)
                {
                    <button type="button" class="course-page-link" aria-label="Next page"
                            @onclick="() => OnPageChanged.InvokeAsync(Page.CurrentPage + 1)">
                        Next
                    </button>
                }
                else
                {
                    <span class="course-page-link" aria-disabled="true">Next</span>
                }
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter, EditorRequired]
    public AvailableCoursesPageViewModel Page { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }
}
