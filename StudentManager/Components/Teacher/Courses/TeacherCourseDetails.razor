@page "/blazor/teacher/courses/{CourseId:int}"
@attribute [Authorize(Roles = "Teacher")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ICourseService CourseService
@inject ILogger<TeacherCourseDetails> Logger

<PageTitle>@(_course?.Name ?? "Course Details") - StudentManager</PageTitle>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_course is null)
{
    <p role="status">Loading course details…</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a href="/blazor/teacher/courses" class="text-decoration-none">&larr; My courses</a>
            <h1 class="mt-2">@_course.Name</h1>
            <p class="text-muted mb-0">@_course.Code</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@($"/blazor/teacher/courses/{_course.CourseId}/edit")"
               class="btn btn-outline-secondary">Edit course</a>
            @if (_course.IsActive)
            {
                <a href="@($"/blazor/teacher/courses/{_course.CourseId}/archive")"
                   class="btn btn-outline-danger">Archive course</a>
            }
        </div>
    </div>

    <section class="mb-4" aria-labelledby="course-details-heading">
        <h2 id="course-details-heading" class="h4">Course details</h2>
        <dl class="row">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(_course.Description)
                    ? "No description provided."
                    : _course.Description)
            </dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">
                <time datetime="@_course.CreatedAt.ToString("O")">
                    @_course.CreatedAt.ToLocalTime().ToString("g")
                </time>
            </dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(_course.IsActive ? "Active" : "Archived")</dd>
        </dl>
    </section>

    <CourseStudentsPreview Course="_course" />
    <p class="mb-3">
        <a class="btn btn-outline-primary" href="@($"/blazor/teacher/courses/{_course.CourseId}/assignments")">Manage assignments</a>
    </p>
    <CourseAssignmentsTable Course="_course" />
}

@code {
    [Parameter]
    public int CourseId { get; set; }

    private Course? _course;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _course = null;
        _errorMessage = null;

        var principal = (await AuthenticationStateProvider
            .GetAuthenticationStateAsync()).User;
        var teacherId = UserManager.GetUserId(principal);

        if (teacherId is null)
        {
            throw new InvalidOperationException(
                "The signed-in teacher account could not be identified.");
        }

        try
        {
            _course = await CourseService.GetTeacherCourseAsync(CourseId, teacherId);
            if (_course is null)
            {
                _errorMessage = "That course could not be found.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load course {CourseId}.", CourseId);
            _errorMessage = "Course details couldn't be loaded. Please try again.";
        }
    }
}
