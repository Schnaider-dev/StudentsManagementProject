<div class="mb-3">
    <label for="course-code" class="form-label">Course Code</label>
    <input id="course-code"
           class="form-control"
           autocomplete="off"
           @bind="Model.Code"
           @bind:event="oninput"
           @bind:after="() => NotifyFieldChanged(nameof(Model.Code))" />
    <ValidationMessage For="@(() => Model.Code)" class="text-danger" />
</div>

<div class="mb-3">
    <label for="course-name" class="form-label">Course Name</label>
    <input id="course-name"
           class="form-control"
           @bind="Model.Name"
           @bind:event="oninput"
           @bind:after="() => NotifyFieldChanged(nameof(Model.Name))" />
    <ValidationMessage For="@(() => Model.Name)" class="text-danger" />
</div>

<div class="mb-3">
    <label for="course-description" class="form-label">Description</label>
    <textarea id="course-description"
              class="form-control"
              rows="4"
              @bind="Model.Description"
              @bind:event="oninput"
              @bind:after="() => NotifyFieldChanged(nameof(Model.Description))"></textarea>
    <ValidationMessage For="@(() => Model.Description)" class="text-danger" />
</div>

@code {
    [Parameter, EditorRequired]
    public ICourseFormModel Model { get; set; } = default!;

    [CascadingParameter]
    private EditContext EditContext { get; set; } = default!;

    private void NotifyFieldChanged(string fieldName) =>
        EditContext.NotifyFieldChanged(new FieldIdentifier(Model, fieldName));
}
