@{
    // The Blazor pages use Components/Layout/MainLayout.razor; this layout only serves the Identity Razor Pages.
    var path = Context.Request.Path.Value ?? string.Empty;

    string NavClass(params string[] prefixes) =>
        prefixes.Any(prefix => path.StartsWith("/" + prefix, StringComparison.OrdinalIgnoreCase))
            ? "nav-link active"
            : "nav-link";

    // The role decides the colour of the strip above the header
    var roleClass = User.IsInRole("Teacher") ? "role-teacher"
                  : User.IsInRole("Student") ? "role-student"
                  : "role-guest";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="StudentManager helps students follow their courses, assignments and grades, and helps teachers run their courses." />
    <title>@ViewData["Title"] - StudentManager</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required:false)
</head>

<body class="@roleClass">
    <svg class="app-icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="icon-book" viewBox="0 0 24 24">
            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" />
            <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20M8 7h8M8 10h6" />
        </symbol>
        <symbol id="icon-clock" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </symbol>
        <symbol id="icon-check" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="m8 12 2.5 2.5L16.5 9" />
        </symbol>
        <symbol id="icon-chart" viewBox="0 0 24 24">
            <path d="M4 19V5M4 19h17" />
            <path d="m7 15 4-4 3 2 5-6" />
            <path d="M16 7h3v3" />
        </symbol>
        <symbol id="icon-clipboard" viewBox="0 0 24 24">
            <rect x="5" y="5" width="14" height="16" rx="2" />
            <path d="M9 5.5V4h6v1.5M8 10h8M8 14h8M8 18h5" />
        </symbol>
        <symbol id="icon-upload" viewBox="0 0 24 24">
            <path d="M12 15V3m0 0L8 7m4-4 4 4" />
            <path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" />
        </symbol>
        <symbol id="icon-award" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="5" />
            <path d="m8.5 12-1 9 4.5-2.5 4.5 2.5-1-9" />
            <path d="m10 8 1.3 1.3L14 6.8" />
        </symbol>
        <symbol id="icon-message-check" viewBox="0 0 24 24">
            <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l1.6-3.2A7.5 7.5 0 1 1 20 11.5Z" />
            <path d="m9 11.5 2 2 4-4" />
        </symbol>
        <symbol id="icon-message-clock" viewBox="0 0 24 24">
            <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l1.6-3.2A7.5 7.5 0 1 1 20 11.5Z" />
            <path d="M12.5 8.5v3l2 1" />
        </symbol>
        <symbol id="icon-info" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
        </symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M16 3v4M8 3v4M3 10h18" />
        </symbol>
        <symbol id="icon-users" viewBox="0 0 24 24">
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.8a3.5 3.5 0 0 1 0 6.4M18 14.2a6.5 6.5 0 0 1 3.5 5.8" />
        </symbol>
    </svg>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="app-header">
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand" href="/">
                    StudentManager
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Student/Dashboard")" href="/Student/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Student/Courses")" href="/Student/Courses/MyCourses">My courses</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Student/Assignments", "Student/Submissions")" href="/Student/Assignments/All">Assignments</a>
                            </li>
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Teacher/Dashboard")" href="/Teacher/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Teacher/Courses")" href="/Teacher/Courses">My courses</a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            &copy; @DateTime.Now.Year StudentManager
        </div>
    </footer>

    @* jQuery нужен только для валидации форм — он подключается в _ValidationScriptsPartial *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>

</html>
