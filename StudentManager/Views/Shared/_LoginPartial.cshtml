@using Microsoft.AspNetCore.Identity
@using StudentManager.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<ul class="navbar-nav align-items-md-center gap-md-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var role = User.IsInRole("Teacher") ? "Teacher"
                 : User.IsInRole("Student") ? "Student"
                 : null;

        var currentUser = await UserManager.GetUserAsync(User);


        @if (role != null)
        {
            <li class="nav-item">
                <span class="role-pill">@role</span>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link" href="/Identity/Account/Manage" title="Account settings">
                @(currentUser is null ? User.Identity?.Name : $"{currentUser.FirstName} {currentUser.LastName}")
            </a>
        </li>

        <li class="nav-item">
            <form method="post" action="/Identity/Account/Logout?returnUrl=%2F" asp-antiforgery="true">
                <button type="submit" class="nav-link btn btn-link">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" href="/Identity/Account/Login">Log in</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3" href="/Identity/Account/Register">Create account</a>
        </li>
    }
</ul>
